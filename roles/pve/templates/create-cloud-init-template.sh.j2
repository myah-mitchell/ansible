#!/bin/bash
set -euo pipefail

DISTRO="ubuntu"
VERSION="26.04"
RELEASE="resolute"
STORAGE_VM="{{ _pve_vm_storage }}"
STORAGE_FS="{{ _pve_fs_storage }}"

# Rendered from admin_ssh_public_keys by the pve role's pve-cloudinit.yml
# task — set that var in a private group_vars/all/private.yml, never here.
SSHKeys=$(cat << 'EOF'
{% for key in admin_ssh_public_keys %}
{{ key }}
{% endfor %}
EOF
)

build_template () {
        local VMID=${VERSION/./}$1

        # Remove existing template, if any (expected to fail on a fresh VMID)
        qm destroy $VMID || true

        # Create a VM
        qm create $VMID --name ubuntu-$BUILD-${VERSION/./} --memory 8192 --balloon 1024 --cores 6 --numa 1 --net0 virtio,bridge=vmbr0,tag=7

        # Import the disk in qcow2 format (as unused disk)
        qm importdisk $VMID /tmp/ubuntu-$VERSION-$BUILD-cloudimg-amd64.img $STORAGE_VM

        # Attach the disk to the vm using VirtIO SCSI
        qm set $VMID --scsihw virtio-scsi-single --scsi0 $STORAGE_VM:vm-$VMID-disk-0,discard=on,ssd=1,iothread=1

        # Create data disk for the vm using VirtIO SCSI
        qm set $VMID --scsihw virtio-scsi-single --scsi1 $STORAGE_VM:40,discard=on,ssd=1,iothread=1

        # Add CloudInit Drive
        qm set $VMID --ide2 $STORAGE_VM:cloudinit

        # Set Boot disk
        qm set $VMID --boot c --bootdisk scsi0

        # Add serial display
        qm set $VMID --serial0 socket --vga serial0

        # Enable QEMU Agent
        qm set $VMID --agent enabled=1

        # The initial disk is only 2GB, thus we make it larger
        qm resize $VMID scsi0 20G

        # Using a dhcp server on vmbr1 or use static IP
        qm set $VMID --ipconfig0 ip=dhcp

        # Admin User
        qm set $VMID --ciuser root
        qm set $VMID --sshkeys <(cat <<<"${SSHKeys}")

        # Add Tags
        qm set $VMID --tags $DISTRO,$VERSION,cloudinit

        # Import vendor.yml (Using the "user" file will prevent the VM from being auto-named to match VMID name.)
        qm set $VMID --cicustom "vendor=$STORAGE_FS:snippets/cloudinit-vendor.yml"

        # Create template
        qm template $VMID
}

# Remove existing image in case last execution did not complete successfully
rm -f /tmp/*-cloudimg-amd64.img

# Build Server Template
wget https://cloud-images.ubuntu.com/releases/$RELEASE/release/ubuntu-$VERSION-server-cloudimg-amd64.img -O /tmp/ubuntu-$VERSION-server-cloudimg-amd64.img
BUILD="server"
build_template "001"

