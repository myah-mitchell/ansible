#cloud-config

package_update: true
{% if pve_cloudinit_mode == 'minimal' %}
packages:
  - qemu-guest-agent

# Minimal mode: the VM only gets the guest agent and the {{ ansible_account }}
# login, then waits for site.yml to provision it over SSH. Packages are not
# upgraded here: the packages role upgrades them, and site.yml reboots a new VM
# afterwards if the upgrade needs it, so first boot never reboots.
#
# The keys are staged as root and moved into place by runcmd, once the account
# exists. Proxmox writes its own users list into user-data, which would replace
# a users key here, so the account is made with useradd instead.
write_files:
  - path: /etc/cloud/{{ ansible_account }}-authorized_keys
    owner: root:root
    permissions: '0600'
    content: |
{% for key in ansible_ssh_public_keys %}
      {{ key }}
{% endfor %}
  - path: /etc/sudoers.d/90-{{ ansible_account }}
    owner: root:root
    permissions: '0440'
    content: |
      {{ ansible_account }} ALL=(ALL:ALL) NOPASSWD: ALL

runcmd:
  - systemctl enable --now qemu-guest-agent
  - id -u {{ ansible_account }} || useradd -m -s /bin/bash -G users,sudo {{ ansible_account }}
  - install -d -m 0700 -o {{ ansible_account }} -g {{ ansible_account }} /home/{{ ansible_account }}/.ssh
  - install -m 0600 -o {{ ansible_account }} -g {{ ansible_account }} /etc/cloud/{{ ansible_account }}-authorized_keys /home/{{ ansible_account }}/.ssh/authorized_keys
  - rm -f /etc/cloud/{{ ansible_account }}-authorized_keys
{% else %}
package_upgrade: true
package_reboot_if_required: true
packages:
  - git
  - ansible

runcmd:
  - git clone https://github.com/{{ github_user }}/ansible /tmp/ansible
{% if ansible_private_repo_token %}
  - git clone {{ ansible_private_repo_url | regex_replace('^https://', 'https://x-access-token:' ~ ansible_private_repo_token ~ '@') }} /tmp/fleet-private
{% endif %}
  - cd /tmp/ansible && ansible-galaxy install -r requirements.yml
  - ansible-playbook -i {{ '/tmp/fleet-private/hosts.yml' if ansible_private_repo_token else '/tmp/ansible/hosts.yml' }} -c local /tmp/ansible/provision.yml -e '{"target":"ubuntu_docker", "server_password":"", "short_name":"{{ short_name }}", "abbr_name":"{{ abbr_name }}", "location_abbr":"{{ location_abbr }}", "domain_name":"{{ domain_name }}"}'
{% endif %}
