# network interface settings; autogenerated
# Please do NOT modify this file directly, unless you know what
# you're doing.
#
# If you want to manage parts of the network configuration manually,
# please utilize the 'source' or 'source-directory' directives to do
# so.
# PVE will preserve these directives, but will NOT read its network
# configuration from sourced files, so do not attempt to move any of
# the PVE managed interfaces into external files!

auto lo
iface lo inet loopback

{% if pve_interfaces['coro0']['ip'] is defined %}
# Coro0 Interface
auto {{ pve_interface_names['coro0'] }}
iface {{ pve_interface_names['coro0'] }} inet static
        address {{ pve_interfaces['coro0']['ip'] }}/{{ pve_interfaces['coro0']['cidr'] | default('24') }}
{% endif %}

{% if pve_interfaces['coro1']['ip'] is defined %}
# Coro1
auto {{ pve_interface_names['coro1'] }}
iface {{ pve_interface_names['coro1'] }} inet static
        address {{ pve_interfaces['coro1']['ip'] }}/{{ pve_interfaces['coro1']['cidr'] | default('24') }}
{% endif %}

# MGMT Primary Interface
auto {{ pve_interface_names['mgmt']['primary'] }}
iface {{ pve_interface_names['mgmt']['primary'] }} inet manual
        bond-master bond0

# MGMT Secondary Interface
auto {{ pve_interface_names['mgmt']['secondary'] }}
iface {{ pve_interface_names['mgmt']['secondary'] }} inet manual
        bond-master bond0

# MGMT Bond
auto bond0
iface bond0 inet manual
        bond-slaves {{ pve_interface_names['mgmt']['primary'] }} {{ pve_interface_names['mgmt']['secondary'] }}
        bond-miimon 100
        bond-mode active-backup
        bond-primary {{ pve_interface_names['mgmt']['primary'] }}

# Primary Bridge
auto vmbr0
iface vmbr0 inet static
        address {{ pve_interfaces['mgmt']['ip'] }}/{{ pve_interfaces['mgmt']['cidr'] | default('24') }}
        gateway {{ pve_interfaces['mgmt']['gw'] | default( pve_interfaces['mgmt']['ip'] | ansible.utils.ipaddr('1')) }}
        bridge-ports bond0
        bridge-stp off
        bridge-fd 0
        bridge-vlan-aware yes
        bridge-vids 2-200,1000-1050

# Ceph Primary Interface
auto {{ pve_interface_names['ceph']['primary'] }}
iface {{ pve_interface_names['ceph']['primary'] }} inet manual
        mtu 9000

# Ceph Secondary Interface
auto {{ pve_interface_names['ceph']['secondary'] }}
iface {{ pve_interface_names['ceph']['secondary'] }} inet manual
        mtu 9000

post-up /usr/bin/systemctl restart frr.service

source /etc/network/interfaces.d/*